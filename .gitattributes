# Line endings
#
# Every generator in scripts/ (node and python) writes LF. With core.autocrlf=true
# and no rules here, git checked those files out as CRLF, so after each build ~70
# course pages showed as "modified" with an empty diff -- stale stat cache plus an
# eol conversion, never a content change. That noise buried real edits: a 6-file
# change arrived looking like a 77-file change.
#
# Storing AND checking out LF makes the worktree byte-identical to the index, so
# there is nothing to convert and nothing to misreport.

* text=auto eol=lf

# Windows batch files are parsed by cmd.exe, which needs CRLF. None exist today;
# this is here so adding one later does not silently break it.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never convert, never diff as text.
*.pdf   binary
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp4   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.xlsx  binary
