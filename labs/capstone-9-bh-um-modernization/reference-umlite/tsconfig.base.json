{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@um-lite/domain": ["libs/domain/src/index.ts"],
      "@um-lite/events": ["libs/events/src/index.ts"],
      "@um-lite/ui": ["libs/ui/src/index.ts"]
    }
  }
}
