<?xml version="1.0" encoding="UTF-8"?>
<!--
  UM-Lite Prior Authorization decision (Phase 3 / Track 3, M17).
  The auto-decision is a DMN decision table — rules, not code — so it can change without a redeploy.
  Referenced by the BPMN business-rule task (camunda:decisionRef="pa-decision").
  hitPolicy FIRST: the first matching rule (top to bottom) wins.
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="Definitions_PaDecision"
             name="PA Decision"
             namespace="http://umlite/dmn">
  <decision id="pa-decision" name="Prior Auth decision">
    <decisionTable id="DecisionTable_PaDecision" hitPolicy="FIRST">

      <input id="Input_units" label="Requested units">
        <inputExpression id="InExpr_units" typeRef="integer">
          <text>requestedUnits</text>
        </inputExpression>
      </input>
      <input id="Input_proc" label="Procedure code">
        <inputExpression id="InExpr_proc" typeRef="string">
          <text>procedureCode</text>
        </inputExpression>
      </input>

      <output id="Output_decision" label="Decision" name="decision" typeRef="string"/>

      <!-- High-volume requests need a human reviewer. -->
      <rule id="Rule_pend">
        <inputEntry id="ie_units_pend"><text>&gt; 10</text></inputEntry>
        <inputEntry id="ie_proc_pend"><text></text></inputEntry>
        <outputEntry id="oe_pend"><text>"PENDED"</text></outputEntry>
      </rule>
      <!-- Total knee replacement: auto-approve at normal volumes. -->
      <rule id="Rule_knee">
        <inputEntry id="ie_units_knee"><text></text></inputEntry>
        <inputEntry id="ie_proc_knee"><text>"27447"</text></inputEntry>
        <outputEntry id="oe_knee"><text>"APPROVED"</text></outputEntry>
      </rule>
      <!-- Default: auto-approve. -->
      <rule id="Rule_default">
        <inputEntry id="ie_units_def"><text></text></inputEntry>
        <inputEntry id="ie_proc_def"><text></text></inputEntry>
        <outputEntry id="oe_def"><text>"APPROVED"</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>
</definitions>
