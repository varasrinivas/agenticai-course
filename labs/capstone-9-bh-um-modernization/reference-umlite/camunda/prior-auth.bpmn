<?xml version="1.0" encoding="UTF-8"?>
<!--
  UM-Lite Prior Authorization process (Phase 3 / Track 3).
  Orchestrates one PA case: auto-decision via a DMN table, an optional human review when pended,
  then an external service task (handled by the um-case-svc worker) that publishes pa.decisioned.
  Deploy to the Camunda engine in docker-compose with `make deploy-bpmn`.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_PriorAuth"
                  targetNamespace="http://umlite/prior-auth">
  <bpmn:process id="prior-auth" name="Prior Authorization" isExecutable="true">

    <bpmn:startEvent id="StartEvent_PaSubmitted" name="PA submitted">
      <bpmn:outgoing>Flow_start_decide</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- M17: the decision is a DMN table, not code. -->
    <bpmn:businessRuleTask id="Task_AutoDecision" name="Auto decision"
        camunda:decisionRef="pa-decision"
        camunda:mapDecisionResult="singleEntry"
        camunda:resultVariable="decision">
      <bpmn:incoming>Flow_start_decide</bpmn:incoming>
      <bpmn:outgoing>Flow_decide_gw</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_NeedsReview" name="Pended?" default="Flow_gw_notify">
      <bpmn:incoming>Flow_decide_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_review</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_notify</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- A human task: only reached when the rules pend the case. -->
    <bpmn:userTask id="Task_ManualReview" name="Manual review">
      <bpmn:incoming>Flow_gw_review</bpmn:incoming>
      <bpmn:outgoing>Flow_review_notify</bpmn:outgoing>
    </bpmn:userTask>

    <!-- M16: external service task — completed by the um-case-svc worker (topic notify-decision). -->
    <bpmn:serviceTask id="Task_NotifyDecision" name="Notify decision"
        camunda:type="external" camunda:topic="notify-decision">
      <bpmn:incoming>Flow_gw_notify</bpmn:incoming>
      <bpmn:incoming>Flow_review_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Done" name="Decisioned">
      <bpmn:incoming>Flow_notify_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_decide" sourceRef="StartEvent_PaSubmitted" targetRef="Task_AutoDecision"/>
    <bpmn:sequenceFlow id="Flow_decide_gw" sourceRef="Task_AutoDecision" targetRef="Gateway_NeedsReview"/>
    <bpmn:sequenceFlow id="Flow_gw_review" name="PENDED" sourceRef="Gateway_NeedsReview" targetRef="Task_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "PENDED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_notify" name="else" sourceRef="Gateway_NeedsReview" targetRef="Task_NotifyDecision"/>
    <bpmn:sequenceFlow id="Flow_review_notify" sourceRef="Task_ManualReview" targetRef="Task_NotifyDecision"/>
    <bpmn:sequenceFlow id="Flow_notify_end" sourceRef="Task_NotifyDecision" targetRef="EndEvent_Done"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="prior-auth">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_PaSubmitted">
        <dc:Bounds x="152" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="138" y="185" width="66" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_AutoDecision" bpmnElement="Task_AutoDecision">
        <dc:Bounds x="240" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway" bpmnElement="Gateway_NeedsReview" isMarkerVisible="true">
        <dc:Bounds x="395" y="135" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="402" y="111" width="38" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManualReview" bpmnElement="Task_ManualReview">
        <dc:Bounds x="370" y="250" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NotifyDecision" bpmnElement="Task_NotifyDecision">
        <dc:Bounds x="540" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_Done">
        <dc:Bounds x="702" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="696" y="185" width="50" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_start_decide" bpmnElement="Flow_start_decide">
        <di:waypoint x="188" y="160"/><di:waypoint x="240" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_decide_gw" bpmnElement="Flow_decide_gw">
        <di:waypoint x="340" y="160"/><di:waypoint x="395" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_gw_review" bpmnElement="Flow_gw_review">
        <di:waypoint x="420" y="185"/><di:waypoint x="420" y="250"/>
        <bpmndi:BPMNLabel><dc:Bounds x="426" y="205" width="44" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_gw_notify" bpmnElement="Flow_gw_notify">
        <di:waypoint x="445" y="160"/><di:waypoint x="540" y="160"/>
        <bpmndi:BPMNLabel><dc:Bounds x="482" y="142" width="22" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_review_notify" bpmnElement="Flow_review_notify">
        <di:waypoint x="470" y="290"/><di:waypoint x="590" y="290"/><di:waypoint x="590" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_notify_end" bpmnElement="Flow_notify_end">
        <di:waypoint x="640" y="160"/><di:waypoint x="702" y="160"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
