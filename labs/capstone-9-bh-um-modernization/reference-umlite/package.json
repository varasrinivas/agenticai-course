{
  "name": "um-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room learning rebuild of a Utilization Management platform",
  "workspaces": [
    "apps/um-intake-svc",
    "apps/intake-ui",
    "libs/domain",
    "libs/events",
    "libs/ui"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "intake:dev": "npm --workspace apps/um-intake-svc run start",
    "ui:dev": "npm --workspace apps/intake-ui run start"
  },
  "devDependencies": {
    "nx": "19.8.4",
    "typescript": "5.5.4"
  }
}
