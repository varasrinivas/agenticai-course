# Copy to .env and adjust as needed. Defaults match docker-compose.

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=umlite
POSTGRES_PASSWORD=umlite

# Kafka (Redpanda)
KAFKA_BROKERS=localhost:9092

# Redis
REDIS_URL=redis://localhost:6379

# Service ports
INTAKE_SVC_PORT=3000
CASE_SVC_PORT=8081

# Intake -> Case service base URL (Phase 1, synchronous REST)
CASE_SVC_BASE_URL=http://localhost:8081

# Phase 2 eventing. Set to true on BOTH services to run the slice over Kafka instead of REST:
#   intake publishes pa.submitted; um-case-svc consumes it and publishes pa.decisioned.
# Leave false to keep the Phase-1 REST slice (M05/M09 labs).
EVENTS_ENABLED=false
