# UM-Lite GraphQL data-as-a-service (Phase 5 / Track 5, M24).
# A read API over the Prior Auth case store: clients ask for exactly the fields they need.
# Served at POST /graphql; explore it at /graphiql (enabled in application.yml).
type Query {
  "All Prior Auth cases."
  cases: [Case!]!
  "One case by id, or null if not found."
  case(id: ID!): Case
  "Cases for a given member."
  casesByMember(memberId: String!): [Case!]!
}

type Case {
  caseId: ID!
  memberId: String!
  providerId: String!
  procedureCode: String!
  diagnosisCode: String!
  requestedUnits: Int!
  status: CaseStatus!
}

enum CaseStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  DENIED
  PENDED
}
