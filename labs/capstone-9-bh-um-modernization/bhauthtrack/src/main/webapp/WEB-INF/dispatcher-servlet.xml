<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring MVC configuration.

  This file plus the @RequestMapping annotations in controller/ define the entire URL surface of
  BHAuthTrack. It is the right starting point for a screen inventory -- and an incomplete one,
  because the view resolver below turns a returned String into a JSP, and the JSPs contain
  business rules the controllers know nothing about.

  The full inventory is: this file, the controllers, AND the JSPs they resolve to.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans.xsd
         http://www.springframework.org/schema/context
         http://www.springframework.org/schema/context/spring-context.xsd
         http://www.springframework.org/schema/mvc
         http://www.springframework.org/schema/mvc/spring-mvc.xsd">

  <context:component-scan base-package="com.bridgeway.bhauth.controller"/>

  <mvc:annotation-driven/>

  <!--
    Static resources. One stylesheet and a date picker. There is no JavaScript framework in this
    application: every screen is a full page render and every state change is a form POST
    followed by a redirect.

    That is the shape a single-page application has to replace. Seven server-rendered screens
    become seven routes plus the client-side state that the HTTP session used to hold.
  -->
  <mvc:resources mapping="/css/**" location="/css/"/>
  <mvc:resources mapping="/js/**"  location="/js/"/>

  <!--
    View resolution. "decision" becomes /WEB-INF/jsp/decision.jsp.

    Every String a controller returns is a filename here. Grep the controllers for `return "`
    and you have the screen list -- seven of them, plus error.jsp.
  -->
  <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
    <property name="prefix" value="/WEB-INF/jsp/"/>
    <property name="suffix" value=".jsp"/>
  </bean>

  <!--
    Date binding. Dates arrive from the forms as yyyy-MM-dd and are bound with a lenient parser,
    so "2016-13-45" becomes a date in 2017 rather than an error. This has produced eligibility
    spans ending before they start.
  -->
  <bean id="dateEditorRegistrar"
        class="com.bridgeway.bhauth.web.DateEditorRegistrar"/>

  <bean class="org.springframework.web.bind.support.ConfigurableWebBindingInitializer">
    <property name="propertyEditorRegistrars">
      <list><ref bean="dateEditorRegistrar"/></list>
    </property>
  </bean>

</beans>
