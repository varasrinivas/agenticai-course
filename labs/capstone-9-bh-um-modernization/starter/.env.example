# Copy to .env. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# Model routing. Reading and reasoning get Sonnet; validation is mechanical
# checking against artifacts that already exist, so it gets Haiku.
COORDINATOR_MODEL=claude-sonnet-4-6
REASONING_MODEL=claude-sonnet-4-6
MECHANICAL_MODEL=claude-haiku-4-5-20251001

# Abort rather than discover a runaway loop on the invoice.
COST_CEILING_OUTPUT_TOKENS=400000
CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=3

# -----------------------------------------------------------------------
# THE PROTECTED-CONTENT ALLOWLIST.
#
# Only paths named here may return narrative-shaped content to the model.
# Everything on it is synthetic, generated from a documented seed.
#
# Widening this to a directory of real extracts defeats the entire control,
# and it is one line away. Do not.
# -----------------------------------------------------------------------
PHI_ALLOWLIST=/work/bhauthtrack/db/02_seed.sql
NARRATIVE_EXCERPT_BUDGET=400

# -----------------------------------------------------------------------
# NOT SET HERE, DELIBERATELY: BH_FINALIZATION_APPROVED.
#
# The agent reads it and cannot write it, which is the whole gate. Putting
# it in a file makes it on-by-default forever, for every future run.
# It belongs on the command line of a job a person types.
# -----------------------------------------------------------------------
