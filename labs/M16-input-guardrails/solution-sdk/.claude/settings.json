{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "command": "python hooks/injection_blocker.py"
      },
      {
        "matcher": "*",
        "command": "python hooks/pii_redactor.py"
      }
    ]
  },
  "permissions": {
