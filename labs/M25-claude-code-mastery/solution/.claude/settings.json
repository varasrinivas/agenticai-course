{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "command": "python .claude/hooks/block_production_writes.py \"$TOOL_INPUT\"",
        "description": "Prevents writing to data/production/ directory"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "command": "python .claude/hooks/audit_log.py \"$TOOL_NAME\" \"$TOOL_INPUT\"",
        "description": "Logs all shell commands for audit trail"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(src/**)",
      "Write(tests/**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Bash(python *)",
      "Bash(npm *)",
      "Bash(git *)"
    ],
    "deny": [
      "Write(data/production/**)",
      "Bash(rm -rf *)",
      "Bash(curl *)"
    ]
  },
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-postgres"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    }
  }
}
