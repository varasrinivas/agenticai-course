# M22B: Environment Variables
# =============================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Anthropic API key (leave as-is to use mock agent)
ANTHROPIC_API_KEY=your-key-here

# GCP settings (Section 3)
GCP_PROJECT_ID=your-gcp-project

# AWS settings (Section 4)
AWS_REGION=us-east-1
