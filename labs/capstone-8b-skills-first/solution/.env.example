# Copy to .env and fill in. Never commit .env.

# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Oracle source (read-only user -- see legacy-oracle/00_user.sql).
ORACLE_USER=migration_reader
ORACLE_PASSWORD=ReadOnly#2026
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_SCHEMA=MERIDIAN

# PostgreSQL target.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=meridian
PG_USER=migration
PG_PASSWORD=migration
PG_TARGET_SCHEMA=ucc_migrated

# Model routing. Hard reasoning gets Sonnet, mechanical volume gets Haiku.
COORDINATOR_MODEL=claude-sonnet-4-6
REASONING_MODEL=claude-sonnet-4-6
MECHANICAL_MODEL=claude-haiku-4-5-20251001

# Cost ceiling. The run aborts rather than discovering a loop on the invoice.
TOKEN_BUDGET=400000

# Cutover. Leave BOTH of these unset for normal runs -- the human-in-the-loop
# gate is the point. CUTOVER_TOKEN is only checked once CUTOVER_APPROVED is set
# by --approve-cutover on the command line.
# CUTOVER_TOKEN=

# Set to 1 to replay canned Oracle responses instead of connecting.
# For hardware that cannot run the Oracle container.
# FIXTURE_MODE=1
