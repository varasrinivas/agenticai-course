# AWS / DNS / CloudFront infra artifacts (machine-specific, account-specific)
# DO NOT commit any JSON config that contains your account ID, distribution ID, or domain.
dns-change-*.json
cloudfront-config-*.json
bucket-policy-*.json
oac-config*.json
output/oac-config*.json
scripts/deploy-config.ps1

# Generated PDF / zip deliverables.
# Rebuilt from the tracked HTML sources by two scripts:
#   scripts/build-study-guide.py  -> study-guide*.pdf   (reportlab, condensed)
#   scripts/build-print-pdfs.py   -> all-mobile-modules.pdf, CC-study-guide.pdf
#                                    (headless Chromium print of the pages)
# Binary and
# non-delta-compressing: every regeneration stored a full new copy, which is
# what grew .git past 100MB. Keep them on disk, out of history.
output/**/*.pdf
output/**/*.zip

# Outputs the labs write when run (harness/run_labs.py exercises all of them)
labs-opensource/**/solution/conversation_state.json
labs-opensource/**/solution/chroma_memory_lab/
labs-opensource/**/solution/smoke_trace.jsonl
labs-opensource/**/solution/traces/
labs-opensource/**/solution/evals/
labs-opensource/**/solution/benchmark_results.*
