# No API key is required for these labs — Ollama runs locally and ignores keys.
# The client uses the placeholder api_key="ollama".

# Optional — hosted alternatives if your machine is too slow for local inference.
# All labs work unchanged: only base_url, api_key, and model change.

# Groq (free tier at https://console.groq.com — very fast open-model inference)
# GROQ_API_KEY=gsk_your_key_here
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Together AI (https://together.ai)
# TOGETHER_API_KEY=your_key_here

# Optional — override the default local model
# OLLAMA_MODEL=mistral
