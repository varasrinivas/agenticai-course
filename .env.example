# ============================================================================
# Claude Agent Development Course — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it contains your API key
# ============================================================================

# Required — get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Optional — for GCP deployment (M22B Tier 2)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional — for AWS deployment (M22B Tier 3)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_DEFAULT_REGION=us-east-1

# Optional — for Slack notifications (CAPSTONE-6 production)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional — for Langfuse tracing (M19-M20)
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com
